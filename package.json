{
    "name": "joplin-plugin-copy-as-html",
    "version": "1.7.1",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/ test/",
        "lint:fix": "eslint src/ test/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run && node --test test/*.test.mjs",
        "knip": "knip"
    },
    "license": "MIT",
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.0.0",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^25.9.4",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.28.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^14.0.0",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "prettier": "^3.9.10 ",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
        "@mathjax/mathjax-tex-font": "^4.1.3",
        "@mathjax/src": "^4.1.3",
        "abcjs": "^6.7.2",
        "dompurify": "^3.4.16",
        "pele": "^1.13.0",
        "remark-emoji": "^5.0.2",
        "remark-flexible-markers": "^1.3.4",
        "remark-gfm": "^4.0.1",
        "remark-ins": "^1.2.4",
        "remark-parse": "^11.0.0",
        "remark-supersub": "^1.0.0",
        "string-width": "^8.3.0",
        "unified": "^11.0.5"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
