{
    "name": "joplin-plugin-copy-as-html",
    "version": "1.7.0",
    "scripts": {
        "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
        "prepare": "npm run dist",
        "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
        "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force",
        "lint": "eslint --ext .ts src/",
        "lint:fix": "eslint --ext .ts src/ --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run",
        "knip": "knip"
    },
    "license": "MIT",
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@swc/core": "^1.16.21",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^25.9.4",
        "@vitest/eslint-plugin": "^1.6.28",
        "chalk": "^4.1.0",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "fs-extra": "^11.3.2",
        "glob": "^8.0.3",
        "globals": "^14.0.0",
        "jsdom": "^30.1.2",
        "knip": "^6.44.1",
        "prettier": "^3.9.10 ",
        "tar": "^7.5.7",
        "terser-webpack-plugin": "^5.5.0",
        "ts-loader": "^9.5.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.1.0",
        "webpack": "^5.103.0",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
        "@mathjax/mathjax-tex-font": "^4.1.3",
        "@mathjax/src": "^4.1.3",
        "abcjs": "^6.7.2",
        "dompurify": "^3.4.16",
        "pele": "^1.13.0",
        "remark-emoji": "^5.0.2",
        "remark-flexible-markers": "^1.3.4",
        "remark-gfm": "^4.0.1",
        "remark-ins": "^1.2.4",
        "remark-parse": "^11.0.0",
        "remark-supersub": "^1.0.0",
        "string-width": "^8.3.0",
        "unified": "^11.0.5"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
