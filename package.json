{
    "name": "joplin-plugin-copy-as-html",
    "version": "1.7.3",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity"
    },
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^2.0.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.19.2",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.50.0",
        "fallow-type-aware": "^3.50.0",
        "jsdom": "^31.0.1",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2008",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
        "@mathjax/mathjax-tex-font": "^4.1.3",
        "@mathjax/src": "^4.1.3",
        "abcjs": "^6.7.3",
        "dompurify": "^3.5.0",
        "pele": "^1.13.0",
        "remark-emoji": "^5.0.2",
        "remark-flexible-markers": "^1.3.4",
        "remark-gfm": "^4.0.1",
        "remark-ins": "^1.2.4",
        "remark-parse": "^11.0.0",
        "remark-supersub": "^1.0.0",
        "string-width": "^9.0.0",
        "unified": "^11.0.5"
    }
}
