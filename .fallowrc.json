{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": ["src/index.ts"],
    "supportEntry": ["src/**/*.test.ts", "src/testUtils/vitestSetup.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off",
        "test-only-exports": "warn"
    },
    "overrides": [
        {
            "files": ["src/testUtils/**"],
            "rules": { "test-only-exports": "off" }
        }
    ],
    "health": {
        "maxCognitive": 15,
        "maxCyclomatic": 20
    }
}
